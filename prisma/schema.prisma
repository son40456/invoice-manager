generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // Used for pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // Used for migrations
}

model InvoiceRequest {
  id           String   @id @default(uuid())
  order_id     String
  tax_id       String
  company_name String
  address      String   @db.Text
  email        String
  phone        String
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String @db.Text
}

model ZaloLog {
  id          String   @id @default(uuid())
  phone       String
  invoice_id  String
  order_id    String
  template_id String
  success     Boolean
  error_code  String?
  error_msg   String?  @db.Text
  createdAt   DateTime @default(now())
}
